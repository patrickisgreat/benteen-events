# ----------------------------------------------------------------------------
# Supabase — from your project dashboard: Settings → API.
# URL + anon (public) key. The anon key is safe in the browser; Row Level
# Security is the authorization boundary, not secrecy.
# ----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-public-key

# Service-role / secret key — SERVER-ONLY, never exposed to the browser.
# Required: the public RSVP route and the Resend webhook are authenticated by
# an opaque token / a signature rather than a session, so they run below RLS.
NUXT_SUPABASE_SECRET_KEY=your-service-role-key

# ----------------------------------------------------------------------------
# Resend — SERVER-ONLY. Powers e-vites, announcements, and reminders.
# Get a key at resend.com.
# ----------------------------------------------------------------------------
NUXT_RESEND_API_KEY=your-resend-api-key
# The From header. Must be a verified Resend sender/domain.
NUXT_RESEND_FROM=Benteen Events <events@example.com>
# Resend webhook signing secret (Resend dashboard → Webhooks) — verifies the
# open/click/delivery callbacks at /api/webhooks/resend. Starts with "whsec_".
NUXT_RESEND_WEBHOOK_SECRET=whsec_your-resend-webhook-secret
# Absolute site URL used in email links (else derived from the request origin).
NUXT_SITE_URL=https://events.example.com

# ----------------------------------------------------------------------------
# Branding — public, shown in the UI and baked into every email.
# ----------------------------------------------------------------------------
NUXT_PUBLIC_APP_NAME=Benteen Events
NUXT_PUBLIC_APP_TAGLINE=Good people, good times.

# ----------------------------------------------------------------------------
# Bearer token for GET /api/crons/reminders. Unprefixed on purpose — Vercel
# Cron sends `Authorization: Bearer $CRON_SECRET`.
# ----------------------------------------------------------------------------
CRON_SECRET=a-long-random-string
